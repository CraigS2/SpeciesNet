# Environment for the automated test suite.
#
# Sourced by `make test`, so a local run and a CI run configure Django
# identically. Every value falls back to a default only when it is not already
# set, which lets CI (or a developer) override any single entry without editing
# this file. These are throwaway credentials for a throwaway database.

export DEBUG="${DEBUG:-0}"
export DEBUG_TOOLBAR="${DEBUG_TOOLBAR:-0}"
export SECRET_KEY="${SECRET_KEY:-test-secret-key-not-for-production}"

export ALLOWED_HOST1="${ALLOWED_HOST1:-localhost}"
export ALLOWED_HOST2="${ALLOWED_HOST2:-127.0.0.1}"
export ALLOWED_HOST3="${ALLOWED_HOST3:-testserver}"
export ALLOWED_HOST4="${ALLOWED_HOST4:-testserver2}"
export CSRF_TRUSTED_ORIGIN1="${CSRF_TRUSTED_ORIGIN1:-http://localhost}"
export CSRF_TRUSTED_ORIGIN2="${CSRF_TRUSTED_ORIGIN2:-http://127.0.0.1}"
export CSRF_TRUSTED_ORIGIN3="${CSRF_TRUSTED_ORIGIN3:-http://testserver}"

# MariaDB, matching production. `make test-db-up` starts a matching container;
# CI provides one as a service. Django's test runner needs CREATE DATABASE, so
# this connects as root.
export DATABASE_ENGINE="${DATABASE_ENGINE:-django.db.backends.mysql}"
export DATABASE_HOST="${DATABASE_HOST:-127.0.0.1}"
export DATABASE_PORT="${DATABASE_PORT:-3306}"
export DATABASE_NAME="${DATABASE_NAME:-speciesnet}"
export DATABASE_USER="${DATABASE_USER:-root}"
export DATABASE_PASSWORD="${DATABASE_PASSWORD:-test_root_password}"

# The container mounts /media and /static; outside it, write under the repo.
export MEDIA_ROOT="${MEDIA_ROOT:-$PWD/.test-media/}"
export STATIC_ROOT="${STATIC_ROOT:-$PWD/.test-static/}"

# Run Celery tasks inline so the suite needs no broker or worker.
export CELERY_TASK_ALWAYS_EAGER="${CELERY_TASK_ALWAYS_EAGER:-True}"
export CELERY_TASK_EAGER_PROPAGATES="${CELERY_TASK_EAGER_PROPAGATES:-True}"
export CELERY_BROKER_URL="${CELERY_BROKER_URL:-memory://}"
export CELERY_RESULT_BACKEND="${CELERY_RESULT_BACKEND:-cache+memory://}"

export EMAIL_BACKEND="${EMAIL_BACKEND:-django.core.mail.backends.locmem.EmailBackend}"
